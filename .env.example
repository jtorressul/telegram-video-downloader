# ==========================================
# CONFIGURACIÓN DEL BOT MULTIMEDIA TELEGRAM
# ==========================================
# Lo único obligatorio es TELEGRAM_BOT_TOKEN. Todo funciona SIN cookies ni cuentas de las plataformas.

# 1. OBLIGATORIO: Token de tu bot obtenido desde @BotFather
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# 2. IDs numéricos de Telegram de los administradores (separados por coma). Pueden usar /diag
ADMIN_IDS=

# 3. Zona horaria para el reinicio de cuotas a medianoche
TIMEZONE=America/New_York

# 4. Puerto del servidor de salud
PORT=8080

# ------------------------------------------
# RED: cómo sale el bot a internet (todo gratis y sin login)
# Ejecuta `python diag.py` en el servidor para ver qué plataformas te bloquean.
# ------------------------------------------
# Bloque IPv6 del VPS para usar una IP distinta en cada descarga (lo imprime deploy/setup_ipv6.sh)
IPV6_PREFIX=
# Cloudflare WARP local como salida alternativa (lo imprime deploy/setup_warp.sh)
WARP_PROXY=
# Proxy propio opcional (http://usuario:pass@ip:puerto o socks5h://ip:puerto)
YTDL_PROXY=

# ------------------------------------------
# SERVICIOS EXTERNOS OPCIONALES
# ------------------------------------------
# Instancias de Cobalt (API v10+), separadas por coma. Descargan desde SUS servidores.
COBALT_INSTANCES=
COBALT_API_KEY=
# Endpoints compatibles con la API de TikWM (por defecto los oficiales de tikwm.com)
TIKTOK_APIS=

# ------------------------------------------
# LÍMITES
# ------------------------------------------
# Máximo de canciones por álbum/playlist de Spotify
SPOTIFY_MAX_TRACKS=25
# Peticiones por minuto por plataforma (no quemar la IP del servidor)
RATE_LIMIT_INSTAGRAM=20
RATE_LIMIT_TIKTOK=40
RATE_LIMIT_YOUTUBE=30

# ------------------------------------------
# MODO CON CUENTA (NO RECOMENDADO)
# ------------------------------------------
# Con ANONYMOUS_ONLY=true (por defecto) estas variables se ignoran.
# Iniciar sesión desde un VPS hace que Instagram suspenda la cuenta.
ANONYMOUS_ONLY=true
IG_USERNAME=
IG_PASSWORD=
INSTAGRAM_SESSIONID=
YOUTUBE_COOKIES=
