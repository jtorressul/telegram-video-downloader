# Token de tu bot obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# Opcional: Cookie de sesión de Instagram para descargar cualquier Reel/Video/Post sin bloqueos
# (Obtén el valor de la cookie 'sessionid' desde las herramientas de desarrollador de tu navegador en instagram.com)
INSTAGRAM_SESSIONID=

# Opcional: Zona horaria para el reinicio de cuotas a las 12:00 AM (por defecto usa la hora local de la máquina)
# Ejemplos: America/New_York, America/Caracas, America/Bogota, America/Santiago, Europe/Madrid
TIMEZONE=

# Opcional: Ruta a un archivo cookies.txt para sitios que requieran inicio de sesión
COOKIES_FILE=cookies.txt
