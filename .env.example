# ==========================================
# CONFIGURACIÓN DEL BOT MULTIMEDIA TELEGRAM
# ==========================================

# 1. OBLIGATORIO: Token de tu bot obtenido desde @BotFather en Telegram
TELEGRAM_BOT_TOKEN=TU_TOKEN_AQUI

# 2. OPCIONAL: IDs numéricos de Telegram de los administradores supremos (separados por coma)
# Ejemplo: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# 3. OPCIONAL: Zona horaria para el reinicio automático de cuotas a las 12:00 AM (medianoche local)
# Ejemplos: America/New_York, America/Caracas, America/Bogota, America/Santiago, Europe/Madrid
TIMEZONE=America/New_York

# 4. OPCIONAL: Puerto para el servidor web de salud en Render (por defecto 8080)
PORT=8080

# 5. OPCIONAL: Cuenta de servicio para Instagram (para Reels o contenido restringido por Meta)
# (100% transparente y Zero-Cookies para los usuarios de Telegram)
IG_USERNAME=
IG_PASSWORD=
INSTAGRAM_SESSIONID=

# 6. OPCIONAL: YouTube Bridge y Bypass de IPs de Render
# Instancia de Cobalt (privada o autohospedada) para enrutar descargas de YouTube sin bloqueos de IP
COBALT_API_URL=

# 7. OPCIONAL: Cookies para YouTube en el servidor
# Si un video requiere verificación o tiene restricción de edad, puedes pegar el contenido
# de tu archivo cookies.txt de YouTube aquí (Zero-Cookies para usuarios de Telegram).
YOUTUBE_COOKIES=

# 8. OPCIONAL: Proxy HTTP o SOCKS5 para yt-dlp (evita bloqueos de IP de datacenter)
# Ejemplo: http://usuario:password@ip:puerto o socks5://ip:puerto
YTDL_PROXY=
